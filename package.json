{
  "name": "mobile-wdio-ts",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform iOS and Android mobile automation with WebdriverIO, Appium, and TypeScript.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test:android": "wdio run ./config/wdio.android.local.conf.ts",
    "test:ios": "wdio run ./config/wdio.ios.local.conf.ts",
    "test:cloud": "wdio run ./config/wdio.cloud.conf.ts",
    "test:cloud:android": "CLOUD_PLATFORM_NAME=Android wdio run ./config/wdio.cloud.conf.ts",
    "test:cloud:ios": "CLOUD_PLATFORM_NAME=iOS wdio run ./config/wdio.cloud.conf.ts",
    "test:android:watch": "wdio run ./config/wdio.android.local.conf.ts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "report:allure": "allure generate ./allure-results --clean -o ./allure-report && allure open ./allure-report",
    "report:allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "appium": "appium --base-path /wd/hub",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@wdio/appium-service": "^9.31.7",
    "@wdio/allure-reporter": "^9.31.4",
    "@wdio/cli": "^9.31.7",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.7",
    "@wdio/mocha-framework": "^9.31.7",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/types": "^9.31.2",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^8.6.1",
    "appium-xcuitest-driver": "^12.11.1",
    "allure-commandline": "^2.43.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-wdio": "^9.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.0",
    "webdriverio": "^9.31.7"
  }
}
