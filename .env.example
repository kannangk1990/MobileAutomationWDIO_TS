# Shared
LOG_LEVEL=info

# Local app under test. Leave empty when the app is already installed on the emulator/simulator.
MOBILE_APP_PATH=

# Android local
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_PLATFORM_VERSION=15
ANDROID_APP_PACKAGE=com.example.app
ANDROID_APP_ACTIVITY=.MainActivity

# iOS local
IOS_DEVICE_NAME=iPhone 16
IOS_PLATFORM_VERSION=18.5
IOS_BUNDLE_ID=com.example.app

# Cloud provider (BrowserStack-compatible example)
CLOUD_PROVIDER=browserstack
CLOUD_USERNAME=
CLOUD_ACCESS_KEY=
CLOUD_APP_ID=
CLOUD_PLATFORM_NAME=Android
CLOUD_DEVICE_NAME=Google Pixel 9
CLOUD_PLATFORM_VERSION=15
CLOUD_PROJECT=mobile-wdio-ts
CLOUD_BUILD=local-build
